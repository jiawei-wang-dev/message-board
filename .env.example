# Firebase Web App configuration.
# Copy this file to .env.local for local development. Cloudflare Pages uses the
# same names in Settings > Environment variables. VITE_ values are bundled into
# the browser and must never contain private service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development only. Production builds ignore these emulator settings even
# if VITE_USE_FIREBASE_EMULATORS is accidentally enabled.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
